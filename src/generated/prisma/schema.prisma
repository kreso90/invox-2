// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  business      Business?
  clients       Client[]
  articles      Article[]
  invoices      Invoice[]
  obligations   Obligation[]
  settings      Settings?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String    @default("local:credential")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Business {
  id                     String   @id @default(cuid())
  business_name          String
  ownerFirstName         String?
  ownerLastName          String?
  oib                    String
  vatId                  String?
  street                 String
  houseNumber            String?
  city                   String
  postalCode             String
  country                String   @default("HR")
  email                  String
  phone                  String?
  bankName               String?
  swiftCode              String?
  iban                   String?
  description            String?
  activity_name          String?
  activity_code          String?
  annual_threshold       Float?
  threshold_warning_pct  Float?
  logo_url               String?
  taxClass               TaxClass @default(CLASS_3)
  mio1MonthlyAmount      Float    @default(119.58)
  mio2MonthlyAmount      Float    @default(39.86)
  healthInsuranceMonthly Float    @default(131.54)
  incomeTaxQuarterly     Float    @default(137.70)
  user                   User     @relation(fields: [userId], references: [id])
  userId                 String   @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Client {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String
  oib              String?
  vatNumber        String?
  vatCountryCode   String?
  address          String?
  city             String?
  postalCode       String?
  contactFirstName String?
  contactLastName  String?
  email            String?
  phone            String?
  iban             String?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  invoices         Invoice[]
}

model Article {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  unit         Unit
  price        Float
  description  String?
  lastUsedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]
}

model Invoice {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceNumber     String
  issueDate         DateTime
  dueDate           DateTime
  servicePeriodFrom DateTime?
  servicePeriodTo   DateTime?
  issuePlace        String?
  paymentMethod     PaymentType      @default(BANK_TRANSFER)
  status            InvoiceStatus    @default(DRAFT)
  note              String?
  totalAmount       Float            @default(0)
  paidAt            DateTime?
  sentAt            DateTime?
  fiscalizedAt      DateTime?
  pdfUrl            String?
  isEmailSent       Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  invoiceItems      InvoiceItem[]
  invoicePayments   InvoicePayment[]

  @@unique([userId, invoiceNumber])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  itemId    String?
  name      String
  quantity  Float
  unit      Unit?
  unitPrice Float
  amount    Float
  sortOrder Int

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Article? @relation(fields: [itemId], references: [id], onDelete: SetNull)
}

model InvoicePayment {
  id        String      @id @default(cuid())
  invoiceId String
  amount    Float
  method    PaymentType @default(BANK_TRANSFER)
  paidAt    DateTime    @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Obligation {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind               ObligationKind
  name               String
  periodLabel        String
  dueDate            DateTime
  amount             Float?
  paymentModel       String?
  paymentReference   String?
  paymentDescription String?
  status             ObligationStatus @default(PENDING)
  submittedAt        DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, kind, periodLabel])
  @@index([userId, dueDate])
}

model Settings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nextInvoiceNumber String @default("1/1/1")
  nextQuoteNumber   String @default("P-1/1/1")

  defaultDueDays       Int         @default(15)
  defaultIssuePlace    String?
  defaultPaymentMethod PaymentType @default(BANK_TRANSFER)
  defaultFooterNote    String?

  emailSenderName      String?
  emailReplyTo         String?
  emailSubjectTemplate String?
  emailBodyTemplate    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Enums

enum PaymentType {
  CASH
  BANK_TRANSFER
}

enum Unit {
  PIECE
  HOUR
  DAY
  MONTH
  YEAR
  METER
  SQUARE_METER
  CUBIC_METER
  KILOMETER
  LITER
  KILOGRAM
  GRAM
  TON
  SET
  PACKAGE
  SERVICE
  LICENSE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
  PARTIALLY_PAID
}

enum TaxClass {
  CLASS_1
  CLASS_2
  CLASS_3
  CLASS_4
  CLASS_5
  CLASS_6
  CLASS_7
}

enum ObligationKind {
  MIO1
  MIO2
  HEALTH_INSURANCE
  INCOME_TAX
  PO_SD_FORM
  KPI_LEDGER
  PDV_FORM
  ZP_FORM
  OTHER
}

enum ObligationStatus {
  PENDING
  SUBMITTED
}
